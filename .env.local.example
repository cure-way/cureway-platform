# ─── Public site origin ───────────────────────────────────────
# Canonical public origin of this deployment, with no trailing slash.
# Single source of truth for every absolute URL the app emits:
# metadataBase, canonical links, Open Graph / Twitter URLs, sitemap,
# robots.txt and JSON-LD. Defaults to the production subdomain when unset.
# Production:  https://cureway.aymanismail.com
# Local dev:   http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://cureway.aymanismail.com

# ─── Auth / API ───────────────────────────────────────────────
# Base URL of the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
