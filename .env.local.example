# ─── Showcase mode ────────────────────────────────────────────
# Runs the whole frontend on local sample data with no backend at all.
#
# Precedence (highest first):
#   1. NEXT_PUBLIC_SHOWCASE_MODE=true   → showcase is ON, even when
#      NEXT_PUBLIC_API_BASE_URL is also set.
#   2. NEXT_PUBLIC_SHOWCASE_MODE=false  → showcase is OFF.
#   3. Unset → showcase turns ON automatically when no API base URL is
#      configured, so a portfolio deployment needs no extra setup.
#
# When ON, the shared axios instance uses a fixture adapter instead of a
# network transport, so no backend request can leave the browser.
NEXT_PUBLIC_SHOWCASE_MODE=true

# ─── Public site origin ───────────────────────────────────────
# Canonical public origin of this deployment, with no trailing slash.
# Single source of truth for every absolute URL the app emits:
# metadataBase, canonical links, Open Graph / Twitter URLs, sitemap,
# robots.txt and JSON-LD. Defaults to the production subdomain when unset.
# Production:  https://cureway.aymanismail.com
# Local dev:   http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://cureway.aymanismail.com

# ─── Auth / API ───────────────────────────────────────────────
# Base URL of the backend API.
#
# The original backend (Railway) has been retired permanently. Leave this
# unset to run in showcase mode. There is deliberately no hardcoded
# fallback: if showcase mode is off and no base URL is set, requests fail
# with an explicit message rather than silently retrying a dead host.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
